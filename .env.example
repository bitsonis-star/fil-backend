# ════════════════════════════════════════════════════════════════
#  FiL (Full in Life) — Environment Variables
#  Copy this file to .env and fill in every value.
#  Never commit .env to GitHub.
# ════════════════════════════════════════════════════════════════

# ── Database (Railway fills this automatically) ──────────────────
DATABASE_URL=mysql://user:password@host:3306/fil

# ── App ──────────────────────────────────────────────────────────
APP_URL=https://api.fil.social
NODE_ENV=production
PORT=3000

# ── Auth ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=PASTE_OPENSSL_OUTPUT_HERE

# ── Stripe ───────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_live_PASTE_HERE
# dashboard.stripe.com → Webhooks → Add endpoint → Signing secret
# Endpoint URL: https://api.fil.social/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_PASTE_HERE
# dashboard.stripe.com → Products → create £9.99/mo recurring → Price ID
STRIPE_PRICE_ID=price_PASTE_HERE

# ── Agora (voice & video calls) ──────────────────────────────────
# console.agora.io → Create project → App ID
AGORA_APP_ID=PASTE_HERE
# Same page → Enable Primary Certificate
AGORA_APP_CERTIFICATE=PASTE_HERE

# ── SendGrid (emails) ────────────────────────────────────────────
# app.sendgrid.com → Settings → API Keys → Create API Key (Full Access)
SENDGRID_API_KEY=SG.PASTE_HERE
# Must be a Verified Sender in SendGrid
FROM_EMAIL=hello@fil.social

# ── AWS S3 (photo storage) ───────────────────────────────────────
# aws.amazon.com → IAM → Users → create user → AmazonS3FullAccess → access key
AWS_ACCESS_KEY_ID=PASTE_HERE
AWS_SECRET_ACCESS_KEY=PASTE_HERE
AWS_REGION=eu-west-1
S3_BUCKET_NAME=fil-photos

# ── Anthropic API (AI engine) ────────────────────────────────────
# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-PASTE_HERE

# ── Google Places (Athens events) ────────────────────────────────
# console.cloud.google.com → Places API → Credentials → Create API Key
GOOGLE_PLACES_KEY=PASTE_HERE
